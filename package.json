{
  "name": "@appsolutely-io/waypoint",
  "version": "0.1.1-next.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appsolutely-io/waypoint.git"
  },
  "homepage": "https://github.com/appsolutely-io/waypoint#readme",
  "bugs": {
    "url": "https://github.com/appsolutely-io/waypoint/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE",
    "README.md",
    "etc",
    "docs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./skin-default": {
      "types": "./dist/skin-default/index.d.ts",
      "import": "./dist/skin-default/index.js",
      "require": "./dist/skin-default/index.cjs"
    },
    "./skin-antd": {
      "types": "./dist/skin-antd/index.d.ts",
      "import": "./dist/skin-antd/index.js",
      "require": "./dist/skin-antd/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./schema.json": "./dist/schema.json",
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "waypoint-conformance": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.hooks.json && tsc --noEmit -p playground/tsconfig.json",
    "lint": "eslint . && prettier --check . && node scripts/privacy.mjs",
    "format": "prettier --write .",
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "release-build": "npm run build && npm run api:check && npm run size",
    "prepublishOnly": "npm run release-build",
    "api:update": "node scripts/api.mjs --local",
    "api:check": "node scripts/api.mjs",
    "size": "size-limit",
    "changeset": "changeset",
    "test:browser": "playwright test --workers=1 && npm run test:playground",
    "test:consumer": "node scripts/consumer.mjs",
    "test:native": "node scripts/native-smoke.mjs && node scripts/native-smoke.mjs dist/hooks/index.js --allow-react",
    "playground": "node --import tsx scripts/playground.mjs",
    "test:playground": "playwright test --config playground/playwright.config.ts --workers=1"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.1.0",
    "antd": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "antd": "^5.29.3",
    "eslint": "^9.39.5",
    "intl-messageformat": "^10.7.18",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-parse": "^11.0.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "unified": "^11.0.5",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "js-yaml": "^4.3.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
