{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react"],
    "skipLibCheck": true,
    "declaration": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests", "fixtures", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
